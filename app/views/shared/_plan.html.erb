<%# The plan chart plus a table of upcoming heater settings. %>
<%= forecast_chart(recommendation) %>
<% changes = plan_changes(recommendation) %>
<% if changes.any? %>
  <div class="table-wrap">
    <table class="scores">
      <thead><tr><th>When</th><th>Set heater to</th><th>Water then</th><th>Ideal then</th></tr></thead>
      <tbody>
        <% changes.each do |c| %>
          <tr><td><%= c[:now] ? "Now" : local_time(c[:time]) %></td><td><strong><%= c[:setpoint] %>°F</strong></td><td>~<%= degrees(c[:water]) %></td><td><%= degrees(c[:ideal]) %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
<% if (comfort = recommendation.details&.dig("comfort")) %>
  <p class="muted">Average error <%= comfort["mean_error"] %>°F · discomfort <%= comfort["mean_discomfort"] %>°F · updated <%= local_time(recommendation.created_at) %></p>
<% end %>
