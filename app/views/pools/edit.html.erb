<% pool = current_pool %>
<% content_for :title, "Settings" %>
<h1>Settings</h1>
<%= render "shared/errors", record: pool %>

<section class="card" id="location"
         data-controller="location-map"
         data-location-map-search-url-value="<%= location_search_path %>"
         <% if pool.located? %>data-location-map-latitude-value="<%= pool.latitude %>" data-location-map-longitude-value="<%= pool.longitude %>"<% end %>>
  <h2>Location</h2>
  <p>
    <% if pool.located? %>
      <strong><%= pool.location_name.presence || "#{pool.latitude}, #{pool.longitude}" %></strong>
      <span class="muted">(<%= pool.time_zone %>)</span>
    <% else %>
      <span class="error">Not set yet.</span> Enter your ZIP code, or tap the map.
    <% end %>
  </p>
  <form class="inline" data-action="submit->location-map#search">
    <label>ZIP code <input type="search" inputmode="numeric" placeholder="e.g. 14618" data-location-map-target="query"></label>
    <button type="submit" class="button secondary">Find</button>
    <button type="button" class="button secondary" data-action="location-map#locate">Use my location</button>
  </form>
  <div class="map" data-location-map-target="map"></div>
  <%= form_with url: location_path, method: :patch, class: "inline" do |f| %>
    <%= f.hidden_field :latitude, data: { location_map_target: "latitude" } %>
    <%= f.hidden_field :longitude, data: { location_map_target: "longitude" } %>
    <%= f.hidden_field :name, data: { location_map_target: "name" } %>
    <%= f.submit "Confirm location", class: "button", disabled: true, data: { location_map_target: "confirm" } %>
    <span class="muted" data-location-map-target="status"></span>
  <% end %>
</section>

<%= render "delivery", pool: pool %>

<%= form_with model: pool, url: pool_path, method: :patch, class: "stack",
              data: { controller: "autosave", action: "change->autosave#save" } do |f| %>
  <section class="card">
    <h2>How you like your pool</h2>
    <div data-controller="range">
      <label>Warmer or cooler than usual
        <%= f.range_field :comfort_adjustment, in: -10..10, step: 1, list: "comfort-marks",
                          data: { range_target: "input", action: "input->range#show" } %>
      </label>
      <datalist id="comfort-marks"><option value="-10"></option><option value="0"></option><option value="10"></option></datalist>
      <p class="range-labels"><span>Cooler</span>
        <strong data-range-target="output"><%= comfort_label(pool.comfort_adjustment) %></strong><span>Warmer</span></p>
    </div>
    <p class="hint">Degrees added to (or taken off) the pool temperature the app aims for, which already follows the weather: warmer on cool days, cooler on hot ones. It never goes above <%= TargetCurve::MAX_POOL_TEMP.to_i %>°F.</p>
  </section>

  <section class="card">
    <h2>Pump and cover</h2>
    <p class="muted">The heater only runs while the pump runs.</p>
    <div class="fields pairs">
      <label>Pump on <%= f.time_field :pump_on_1 %></label>
      <label>Pump off <%= f.time_field :pump_off_1 %></label>
      <label>Pump on again (optional) <%= f.time_field :pump_on_2 %></label>
      <label>Pump off again (optional) <%= f.time_field :pump_off_2 %></label>
    </div>
    <div class="fields">
      <label class="check"><%= f.check_box :has_cover %> I have a pool cover</label>
    </div>
    <p class="hint">With a cover, the app will tell you when to take it off so the pool cools faster, and when to put it back.</p>
  </section>

  <section class="card">
    <h2>Alerts</h2>
    <div class="fields">
      <label>Pool name <%= f.text_field :name %></label>
      <label>Check and adjust
        <%= f.select :checks_per_day, Pool::CHECK_HOURS.map { |n, hours| ["#{n}× a day (#{hours.map { |h| Time.zone.parse("#{h}:00").strftime("%-l%P") }.join(', ')})", n] } %>
      </label>
      <label class="check"><%= f.check_box :notifications_enabled %> Send alerts</label>
    </div>
  </section>

  <details class="card advanced" id="advanced">
    <summary><h2>Advanced</h2></summary>
    <h3>Ideal pool temperature</h3>
    <p class="muted">Two points define a straight line from the day's average air temperature to the ideal pool temperature (before your warmer/cooler setting). It keeps going past both points.</p>
    <div class="fields pairs">
      <label>Hot day: air (°F) <%= f.number_field :hot_air_temp, step: "any" %></label>
      <label>Hot day: pool (°F) <%= f.number_field :hot_pool_temp, step: "any" %></label>
      <label>Cold day: air (°F) <%= f.number_field :cold_air_temp, step: "any" %></label>
      <label>Cold day: pool (°F) <%= f.number_field :cold_pool_temp, step: "any" %></label>
    </div>
    <% if pool.hot_air_temp != pool.cold_air_temp %>
      <% curve = TargetCurve.for(pool) %>
      <p class="muted">The pool changes <%= curve.slope.round(2) %>°F for every 1°F change in air. At 65°F air the pool should be <%= degrees(curve.pool_temp_for(65)) %> (with your warmer/cooler setting).</p>
    <% end %>
    <div class="fields">
      <label>Warm-day threshold (°F)
        <%= f.number_field :warm_day_threshold, step: "any" %>
        <span class="hint">On days warmer than this, a pool a little cooler than ideal is fine; on cooler days, a little warmer is fine. The planner uses that when it can't hit the ideal exactly.</span>
      </label>
    </div>

    <h3>Heating and cooling</h3>
    <div class="fields">
      <label>Heats up (°F per hour, pump on) <%= f.number_field :heat_rate_per_hour, step: "any", min: 0.01 %></label>
      <label>Cooling factor <%= f.number_field :cooling_factor, step: "any", min: 0.1 %>
        <span class="hint">1 is standard: covered, a 100°F pool loses about 3°F/day at 35°F air. Uncovered it loses about 6°F/day at 35°F air and 2°F/day at 90°F. Raise it if your pool cools faster than that, lower it if slower.</span>
      </label>
    </div>

    <h3>Alerts</h3>
    <p>
      <button type="submit" form="test-message-form" class="button secondary">Send test message</button>
      <span class="hint">Sends a message to <%= pool.contact_verified? ? "your #{pool.channel_label} chat" : "your alerts (once Telegram is connected)" %> so you can see how alerts look.</span>
    </p>

    <h3>Planning</h3>
    <div class="fields">
      <label>Only alert when the change is at least (°F) <%= f.number_field :min_change, min: 1 %></label>
      <label>Suggest running the pump around the clock when the pool would be more than (°F) short
        <%= f.number_field :pump_boost_threshold, step: "any", min: 0 %>
        <span class="hint">Only when heating flat out during your normal pump hours still can't keep up, e.g. a sudden cold snap or a pool party.</span>
      </label>
      <label>Planner
        <%= f.select :strategy, Recommenders.registry.map { |key, klass| [klass.label, key] } %>
        <span class="hint"><%= Recommenders.registry.values.map { |k| "#{k.label}: #{k.description}" }.join(" ") %> Compare them in the <%= link_to "Lab", lab_path %>.</span>
      </label>
    </div>
  </details>

  <div class="inline save-bar">
    <%= f.submit "Save settings", class: "button" %>
    <span class="save-status muted" data-autosave-target="status" aria-live="polite">Changes save automatically.</span>
  </div>
<% end %>

<%= form_with url: test_message_path, id: "test-message-form", html: { hidden: true } do %><% end %>

<details class="card advanced" id="test-mode">
  <summary><h2>Test mode</h2></summary>
  <p class="muted">Plan against a saved forecast so results don't change while you compare settings and planners. "Now" stays at the moment the forecast was saved, and no alerts are sent.</p>
  <% snapshots = pool.forecast_snapshots.recent %>
  <%= form_with url: test_mode_path, method: :patch, class: "inline" do |f| %>
    <label>Plan with
      <%= f.select :snapshot_id, [ [ "Live forecast (test mode off)", "" ] ] + snapshots.map { |s| [ s.label, s.id ] },
                   selected: pool.test_snapshot_id %>
    </label>
    <%= f.submit "Use", class: "button secondary" %>
  <% end %>
  <div class="inline">
    <%= button_to "Save the forecast behind the current plan", forecast_snapshots_path, params: { source: "plan" }, class: "button secondary" %>
    <%= button_to "Save the live forecast now", forecast_snapshots_path, params: { source: "live" }, class: "button secondary" %>
  </div>
  <% if snapshots.any? %>
    <ul class="snapshots">
      <% snapshots.each do |s| %>
        <li><%= s.label %> <span class="muted">· water <%= degrees(s.water_temp) %></span>
          <%= button_to "Delete", forecast_snapshot_path(s), method: :delete, class: "link" %></li>
      <% end %>
    </ul>
  <% end %>
</details>
