<% pool = current_pool %>
<% content_for :title, "Settings" %>
<h1>Settings</h1>
<%= render "shared/errors", record: pool %>

<section class="card" id="location"
         data-controller="location-map"
         data-location-map-search-url-value="<%= location_search_path %>"
         <% if pool.located? %>data-location-map-latitude-value="<%= pool.latitude %>" data-location-map-longitude-value="<%= pool.longitude %>"<% end %>>
  <h2>Location</h2>
  <p>
    <% if pool.located? %>
      <strong><%= pool.location_name.presence || "#{pool.latitude}, #{pool.longitude}" %></strong>
      <span class="muted">(<%= pool.time_zone %>)</span>
    <% else %>
      <span class="error">Not set yet.</span> Enter your ZIP code, or tap the map.
    <% end %>
  </p>
  <form class="inline" data-action="submit->location-map#search">
    <input type="search" inputmode="numeric" placeholder="ZIP code or city" aria-label="ZIP code or city" data-location-map-target="query">
    <button type="submit" class="button secondary">Find</button>
    <button type="button" class="button secondary" data-action="location-map#locate">Use my location</button>
  </form>
  <div class="map" data-location-map-target="map"></div>
  <%= form_with url: location_path, method: :patch, class: "inline" do |f| %>
    <%= f.hidden_field :latitude, data: { location_map_target: "latitude" } %>
    <%= f.hidden_field :longitude, data: { location_map_target: "longitude" } %>
    <%= f.hidden_field :name, data: { location_map_target: "name" } %>
    <%= f.submit "Confirm location", class: "button", disabled: true, data: { location_map_target: "confirm" } %>
    <span class="muted" data-location-map-target="status"></span>
  <% end %>
</section>

<%= render "delivery", pool: pool %>

<%= form_with model: pool, url: pool_path, method: :patch, class: "stack" do |f| %>
  <section class="card">
    <h2>Ideal pool temperature</h2>
    <p class="muted">Two points define a straight line from the day's average air temperature to the ideal pool temperature. It keeps going past both points.</p>
    <div class="fields pairs">
      <label>Hot day: air (°F) <%= f.number_field :hot_air_temp, step: "any" %></label>
      <label>Hot day: pool (°F) <%= f.number_field :hot_pool_temp, step: "any" %></label>
      <label>Cold day: air (°F) <%= f.number_field :cold_air_temp, step: "any" %></label>
      <label>Cold day: pool (°F) <%= f.number_field :cold_pool_temp, step: "any" %></label>
    </div>
    <% if pool.hot_air_temp != pool.cold_air_temp %>
      <% curve = TargetCurve.for(pool) %>
      <p class="muted">The pool changes <%= curve.slope.round(2) %>°F for every 1°F change in air. At 65°F air the pool should be <%= degrees(curve.pool_temp_for(65)) %>.</p>
    <% end %>
    <div class="fields">
      <label>Warm-day threshold (°F)
        <%= f.number_field :warm_day_threshold, step: "any" %>
        <span class="hint">On days warmer than this, a pool a little cooler than ideal is fine; on cooler days, a little warmer is fine. The planner uses that when it can't hit the ideal exactly.</span>
      </label>
    </div>
  </section>

  <section class="card">
    <h2>How fast the pool changes</h2>
    <div class="fields">
      <label>Heats up (°F per day) <%= f.number_field :heat_rate_per_day, step: "any", min: 0.1 %></label>
      <label>Cools down (°F per day) <%= f.number_field :cool_rate_per_day, step: "any", min: 0.1 %></label>
    </div>
  </section>

  <section class="card">
    <h2>Alerts</h2>
    <div class="fields">
      <label>Pool name <%= f.text_field :name %></label>
      <label>Check and adjust
        <%= f.select :checks_per_day, Pool::CHECK_HOURS.map { |n, hours| ["#{n}× a day (#{hours.map { |h| Time.zone.parse("#{h}:00").strftime("%-l%P") }.join(', ')})", n] } %>
      </label>
      <label>Only alert when the change is at least (°F) <%= f.number_field :min_change, min: 1 %></label>
      <label>Planner
        <%= f.select :strategy, Recommenders.registry.map { |key, klass| [klass.label, key] } %>
        <span class="hint"><%= Recommenders.registry.values.map { |k| "#{k.label}: #{k.description}" }.join(" ") %> Compare them in the <%= link_to "Lab", lab_path %>.</span>
      </label>
      <label class="check"><%= f.check_box :notifications_enabled %> Send alerts</label>
    </div>
  </section>

  <div><%= f.submit "Save settings", class: "button" %></div>
<% end %>

<section class="card" id="test-mode">
  <h2>Test mode</h2>
  <p class="muted">Plan against a saved forecast so results don't change while you compare settings and planners. "Now" stays at the moment the forecast was saved, and no alerts are sent.</p>
  <% snapshots = pool.forecast_snapshots.recent %>
  <%= form_with url: test_mode_path, method: :patch, class: "inline" do |f| %>
    <label>Plan with
      <%= f.select :snapshot_id, [ [ "Live forecast (test mode off)", "" ] ] + snapshots.map { |s| [ s.label, s.id ] },
                   selected: pool.test_snapshot_id %>
    </label>
    <%= f.submit "Use", class: "button secondary" %>
  <% end %>
  <div class="inline">
    <%= button_to "Save the forecast behind the current plan", forecast_snapshots_path, params: { source: "plan" }, class: "button secondary" %>
    <%= button_to "Save the live forecast now", forecast_snapshots_path, params: { source: "live" }, class: "button secondary" %>
  </div>
  <% if snapshots.any? %>
    <ul class="snapshots">
      <% snapshots.each do |s| %>
        <li><%= s.label %> <span class="muted">· water <%= degrees(s.water_temp) %></span>
          <%= button_to "Delete", forecast_snapshot_path(s), method: :delete, class: "link" %></li>
      <% end %>
    </ul>
  <% end %>
</section>
