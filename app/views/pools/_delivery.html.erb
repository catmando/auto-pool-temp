<%# Telegram only for now. SMS (PhoneVerification, Twilio) stays in the code for later. %>
<section class="card" id="delivery">
  <h2>Alerts in Telegram</h2>
  <% if !TelegramBot.configured? %>
    <p class="muted">The Telegram bot isn't set up yet (no bot token).</p>
  <% elsif pool.telegram_linked? %>
    <p><span class="ok">Connected ✓</span> <span class="muted">since <%= local_time(pool.telegram_linked_at, pool) %></span></p>
    <%= button_to "Disconnect", telegram_link_path, method: :delete, class: "button secondary" %>
  <% elsif (url = telegram_link_url(pool)) %>
    <p><%= link_to "Open Telegram to connect", url, class: "button", target: "_blank", rel: "noopener" %></p>
    <p class="muted">Then press <strong>Start</strong> in Telegram. This link works once, for 30 minutes.</p>
    <%= button_to "Make a new link", telegram_link_path, class: "link" %>
  <% else %>
    <p><span class="error">Not connected yet, so no alerts will be sent.</span></p>
    <%= button_to "Connect Telegram", telegram_link_path, class: "button" %>
  <% end %>
</section>
