<turbo-frame id="settings_plan">
  <% if @plan.nil? %>
    <p class="muted">Set a location to see the plan.</p>
  <% elsif @plan.recommendation %>
    <% if @plan.error %><p class="error"><%= @plan.error %></p><% end %>
    <%= render "shared/plan", recommendation: @plan.recommendation %>
  <% else %>
    <p class="error"><%= @plan.error %></p>
  <% end %>
</turbo-frame>
