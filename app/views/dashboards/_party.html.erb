<section class="card" id="party" data-controller="parties">
  <h2>Pool party</h2>
  <p class="muted">Having people over? Pick when, and how much warmer you want the pool. The plan heats ahead so it's ready when the party starts.</p>
  <% pool.pool_parties.upcoming.each do |party| %>
    <%= render "dashboards/party_block", party: party, pool: pool, recommendation: recommendation %>
  <% end %>
  <div data-parties-target="blank">
    <%= render "dashboards/party_block", party: PoolParty.new(pool: pool), pool: pool, recommendation: recommendation %>
  </div>
</section>
