<% pool = current_pool %>
<% water = pool.estimated_water_temp %>
<div class="grid3">
  <section class="card">
    <h2>Heater setting</h2>
    <p class="big"><%= degrees(pool.assumed_setpoint) %></p>
    <p class="muted"><%= setpoint_source_label(pool.setpoint_source) %><% if pool.setpoint_updated_at %>, <%= local_time(pool.setpoint_updated_at) %><% end %></p>
    <%= form_with url: setpoint_path, method: :patch, class: "inline" do |f| %>
      <label>Actually set to <%= f.number_field :assumed_setpoint, min: 40, max: 110, value: pool.assumed_setpoint, class: "short" %>°F</label>
      <%= f.submit "Update", class: "button secondary" %>
    <% end %>
  </section>

  <section class="card">
    <h2>Water</h2>
    <p class="big"><%= water ? "~#{degrees(water)}" : "—" %></p>
    <p class="muted"><%= water_source_label(pool) %></p>
    <%= form_with url: water_temp_path, method: :patch, class: "inline" do |f| %>
      <label>Measured <%= f.number_field :water_temp, min: 32, max: 110, step: 0.5, class: "short" %>°F</label>
      <%= f.submit "Update", class: "button secondary" %>
    <% end %>
  </section>

  <section class="card">
    <h2>Recommendation</h2>
    <% if @recommendation %>
      <p class="big"><%= degrees(@recommendation.target_temp) %></p>
      <p><%= @recommendation.reason %></p>
      <p class="muted">
        Updated <%= local_time(@recommendation.created_at) %> · <%= @recommendation.strategy %> ·
        <%= @recommendation.notified? ? "alert sent" : "no alert" %>
      </p>
    <% else %>
      <p class="muted">No checks yet.</p>
    <% end %>
    <% unless pool.test_mode? %>
      <%= button_to "Send alert now if needed", checks_path, params: { notify: "1" }, class: "button secondary" %>
    <% end %>
  </section>
</div>

<% if @recommendation %>
  <section class="card">
    <h2>Plan</h2>
    <%= forecast_chart(@recommendation) %>
    <% changes = plan_changes(@recommendation) %>
    <% if changes.any? %>
      <div class="table-wrap">
        <table class="scores">
          <thead><tr><th>When</th><th>Set heater to</th><th>Water then</th><th>Ideal then</th></tr></thead>
          <tbody>
            <% changes.each do |c| %>
              <tr><td><%= c[:now] ? "Now" : local_time(c[:time]) %></td><td><strong><%= c[:setpoint] %>°F</strong></td><td>~<%= degrees(c[:water]) %></td><td><%= degrees(c[:ideal]) %></td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>
<% end %>

<section class="card">
  <h2>Schedule</h2>
  <p>
    <%= pool.location_name.presence || "#{pool.latitude}, #{pool.longitude}" %> (<%= pool.time_zone %>).
    Checks at <%= pool.check_hours.map { |h| Time.zone.parse("#{h}:00").strftime("%-l%P") }.to_sentence %> local time;
    alerts go to Telegram<% if !pool.notifications_enabled? %> (paused)<% elsif !pool.contact_verified? %> (<%= link_to "not connected yet", edit_pool_path(anchor: "delivery") %>, so nothing is sent)<% end %>.
  </p>
  <p class="muted">Last scheduled check: <%= local_time(pool.last_checked_at) %>.</p>
</section>

<% if @text_messages.any? %>
  <section class="card">
    <h2>Recent messages</h2>
    <%= render "text_messages/list", text_messages: @text_messages %>
    <p><%= link_to "All messages", text_messages_path %></p>
  </section>
<% end %>
