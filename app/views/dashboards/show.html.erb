<% pool = current_pool %>
<% water = pool.estimated_water_temp %>
<%= turbo_stream_from pool %><%# hourly re-plans and scheduled checks refresh this page %>
<div class="top-row">
  <section class="card settings-card">
    <h2>Recommended settings</h2>
    <% if @recommendation %>
      <% pump_extra = @recommendation.details&.dig("pump_extra") %>
      <% cover_on = @recommendation.details&.dig("cover_on") %>
      <dl class="settings">
        <div><dt>Heater</dt><dd><%= degrees(@recommendation.target_temp) %></dd></div>
        <div><dt>Pump</dt><dd><%= pump_extra ? "Leave on 24 hours" : "Normal schedule" %>
          <% unless pump_extra %><span class="muted">(<%= pool.pump_schedule.describe %>)</span><% end %></dd></div>
        <% if pool.has_cover? && !cover_on.nil? %>
          <div><dt>Pool cover</dt><dd><%= cover_on ? "On" : "Off" %></dd></div>
        <% end %>
      </dl>
      <p><%= @recommendation.reason %></p>
      <p class="muted">Updated <%= local_time(@recommendation.created_at) %><%= " · alert sent" if @recommendation.notified? %></p>
    <% else %>
      <p class="muted">No plan yet.</p>
    <% end %>
  </section>

  <section class="card water-card">
    <h2>Current water temp</h2>
    <p class="big"><%= water ? "~#{degrees(water)}" : "—" %></p>
    <p class="muted">Expected from the plan, the weather, and your pump schedule.</p>
    <%= form_with url: water_temp_path, method: :patch, class: "inline" do |f| %>
      <label>Actual <%= f.number_field :water_temp, min: 32, max: 110, step: 0.5, class: "short" %>°F</label>
      <%= f.submit "Log it", class: "button secondary" %>
    <% end %>
    <p class="hint">Logging actual temps helps improve the algorithm's accuracy.</p>
    <% if (reading = pool.pool_logs.recent.where.not(water_temp: nil).first) %>
      <p class="hint">Last reading <%= degrees(reading.water_temp) %>, <%= local_time(reading.logged_at) %><% if reading.expected_water_temp %> (expected <%= degrees(reading.expected_water_temp) %>)<% end %>.</p>
    <% end %>
  </section>
</div>

<%= render "party", pool: pool, recommendation: @recommendation %>

<% if @recommendation %>
  <section class="card">
    <h2>Plan</h2>
    <%= render "shared/plan", recommendation: @recommendation %>
  </section>
<% end %>

<section class="card">
  <h2>Schedule</h2>
  <p>
    <%= pool.location_name.presence || "#{pool.latitude}, #{pool.longitude}" %> (<%= pool.time_zone %>).
    Checks at <%= pool.check_hours.map { |h| Time.zone.parse("#{h}:00").strftime("%-l%P") }.to_sentence %> local time;
    alerts go to Telegram<% if !pool.notifications_enabled? %> (paused)<% elsif !pool.contact_verified? %> (<%= link_to "not connected yet", edit_pool_path(anchor: "delivery") %>, so nothing is sent)<% end %>.
  </p>
  <p class="muted">Last scheduled check: <%= local_time(pool.last_checked_at) %>.</p>
</section>

<% if @text_messages.any? %>
  <section class="card">
    <h2>Recent messages</h2>
    <%= render "text_messages/list", text_messages: @text_messages %>
    <p><%= link_to "All messages", text_messages_path %></p>
  </section>
<% end %>
