<%# One party: an editable form. Saved parties show what will happen and a Delete
    button; editing one swaps that for "Plan the party" until it's saved again. %>
<% saved = party.persisted? %>
<div class="party-block <%= 'saved' if saved %>" data-controller="party" data-party-saved-value="<%= saved %>">
  <%= form_with url: saved ? pool_party_path(party) : pool_parties_path, method: saved ? :patch : :post, class: "stack",
                data: { action: "input->party#edited change->party#edited" } do |f| %>
    <div class="fields party-when">
      <label>Date <%= f.date_field :start_date, value: party.start_date, required: true, min: (saved ? nil : Date.current),
                                    data: { party_target: "startDate", action: "change->party#startDateChanged" } %></label>
      <label>From <%= f.time_field :start_time, value: party.start_time %></label>
      <label>How much warmer
        <%= f.select :boost, PoolParty::BOOSTS.map { |b| [ "+#{b}°F", b ] }, selected: saved ? party.boost : 5 %>
      </label>
    </div>
    <div class="fields party-when">
      <label>Until (date) <%= f.date_field :end_date, value: party.end_date, data: { party_target: "endDate" } %></label>
      <label>Until (time) <%= f.time_field :end_time, value: party.end_time %></label>
    </div>
    <div data-party-target="submit" <%= "hidden" if saved %>><%= f.submit "Plan the party", class: "button" %></div>
  <% end %>
  <% if saved %>
    <div class="party-outlook" data-party-target="outlook">
      <% outlook = party_outlook(party, recommendation) %>
      <p><strong><%= party.label %></strong> · +<%= party.boost %>°F</p>
      <% if outlook %>
        <p>It'll be about <%= degrees(outlook[:air]) %> outside. Your pool target is <strong><%= degrees(outlook[:target]) %></strong>
          (usually <%= degrees(outlook[:usual]) %>), and the water should be <%= degrees(outlook[:water]) %> when the party starts.</p>
        <% if outlook[:target].round <= outlook[:usual].round %>
          <p class="hint">That's no warmer than usual: the party boost replaces your everyday warmer/cooler setting (+<%= pool.comfort_adjustment %>°F). Raise "How much warmer" to make it warmer.</p>
        <% end %>
      <% else %>
        <p class="muted">Too far out to forecast yet. Planning starts when it's within the 16-day forecast.</p>
      <% end %>
      <%= button_to "Delete", pool_party_path(party), method: :delete, class: "button secondary" %>
    </div>
  <% end %>
</div>
