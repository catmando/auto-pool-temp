#!/usr/bin/env ruby
# Starts the app locally with foreman (Procfile.dev):
#   web    - Rails + the Solid Queue job worker inside Puma
#   tunnel - (opt-in) cloudflared tunnel + webhook registration (bin/tunnel)
#
#   bin/dev                # web only, on port 3000
#   PORT=3124 bin/dev      # another port
#   TUNNEL=1 bin/dev       # also take over the Telegram/Twilio webhooks
#
# The deployed app (Fly) owns the webhooks and the scheduled checks. TUNNEL=1
# points the webhooks at this machine instead; afterwards run
#   bin/rails 'notify:webhooks[https://auto-pool-temp.fly.dev]'
# to hand them back.

Dir.chdir(File.expand_path("..", __dir__))
ENV["APP_PORT"] = ENV.fetch("PORT", "3000") # foreman rewrites PORT per process

unless system("gem list --silent --installed foreman > /dev/null 2>&1") || system("which foreman > /dev/null 2>&1")
  puts "Installing foreman..."
  system("gem install foreman") || abort("Couldn't install foreman")
end

tunnel = !ENV["TUNNEL"].to_s.empty?
if tunnel && !system("which cloudflared > /dev/null 2>&1")
  abort "TUNNEL=1 needs cloudflared: brew install cloudflared"
end
puts "Webhooks are being taken over by this machine (TUNNEL=1)." if tunnel

exec "foreman", "start", "-f", "Procfile.dev", "-m", "web=1,tunnel=#{tunnel ? 1 : 0}", *ARGV
