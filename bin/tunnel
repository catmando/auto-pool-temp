#!/usr/bin/env ruby
# Opens a Cloudflare quick tunnel to the local app and points the Twilio
# number's incoming-SMS webhook at it, so text replies reach bin/dev.
# The quick-tunnel URL changes every run; this re-registers it each time, and
# restarts the tunnel if cloudflared exits (foreman would otherwise stop
# everything). Normally started by bin/dev via Procfile.dev.
#
#   bin/tunnel          # tunnels http://localhost:3000
#   bin/tunnel 3124     # another port

$stdout.sync = true
port = ARGV.first || "3000"
root = File.expand_path("..", __dir__)
cloudflared = ENV.fetch("CLOUDFLARED", "cloudflared")
abort "cloudflared not found. Install it with: brew install cloudflared" unless system("which #{cloudflared} > /dev/null")

pid = nil
stopping = false
%w[INT TERM].each do |signal|
  trap(signal) do
    stopping = true
    Process.kill("TERM", pid) if pid rescue nil
  end
end

until stopping
  reader, writer = IO.pipe
  pid = spawn(cloudflared, "tunnel", "--no-autoupdate", "--url", "http://localhost:#{port}", out: writer, err: writer)
  writer.close

  registered = false
  reader.each_line do |line|
    next if registered || !(url = line[%r{https://[a-z0-9-]+\.trycloudflare\.com}])

    registered = true
    puts "Tunnel: #{url} -> http://localhost:#{port}"
    if system(File.join(root, "bin/rails"), "twilio:webhook[#{url}]", chdir: root)
      puts "Text replies now reach this machine."
    else
      puts "Twilio webhook not updated (see above). The tunnel is up; replies won't arrive until Twilio is configured."
    end
  end

  Process.wait(pid)
  break if stopping

  puts "cloudflared exited; restarting the tunnel in 5 seconds..."
  sleep 5
end
