#!/usr/bin/env ruby
# Opens a Cloudflare quick tunnel to the local app and points the Twilio and
# Telegram webhooks at it (bin/rails notify:webhooks), so replies reach bin/dev.
# The quick-tunnel URL changes every run; this re-registers it each time, and
# restarts the tunnel if cloudflared exits (foreman would otherwise stop
# everything). Normally started by bin/dev via Procfile.dev.
#
#   bin/tunnel          # tunnels http://localhost:3000
#   bin/tunnel 3124     # another port

$stdout.sync = true
port = ARGV.first || "3000"
root = File.expand_path("..", __dir__)
cloudflared = ENV.fetch("CLOUDFLARED", "cloudflared")
abort "cloudflared not found. Install it with: brew install cloudflared" unless system("which #{cloudflared} > /dev/null")

require "net/http"

# A new quick-tunnel hostname takes a few seconds to resolve, and Telegram
# refuses to register a webhook whose host it can't resolve. So wait until the
# tunnel answers (the app's /up check) before registering, and retry.
def register_webhooks(url, root)
  deadline = Time.now + 90
  until Time.now > deadline
    break if (Net::HTTP.get_response(URI("#{url}/up")).is_a?(Net::HTTPSuccess) rescue false)

    sleep 3
  end

  3.times do |attempt|
    if system(File.join(root, "bin/rails"), "notify:webhooks[#{url}]", chdir: root)
      puts "Replies (Telegram / SMS) now reach this machine."
      return
    end
    puts "Retrying webhook registration..." if attempt < 2
    sleep 10
  end
  puts "Some webhooks weren't updated (see above). The tunnel is still up; run: bin/rails 'notify:webhooks[#{url}]'"
end

pid = nil
stopping = false
%w[INT TERM].each do |signal|
  trap(signal) do
    stopping = true
    Process.kill("TERM", pid) if pid rescue nil
  end
end

until stopping
  reader, writer = IO.pipe
  pid = spawn(cloudflared, "tunnel", "--no-autoupdate", "--url", "http://localhost:#{port}", out: writer, err: writer)
  writer.close

  registered = false
  reader.each_line do |line|
    next if registered || !(url = line[%r{https://[a-z0-9-]+\.trycloudflare\.com}])

    registered = true
    puts "Tunnel: #{url} -> http://localhost:#{port}"
    # Register in a thread so cloudflared's output keeps draining meanwhile.
    Thread.new { register_webhooks(url, root) }
  end

  Process.wait(pid)
  break if stopping

  puts "cloudflared exited; restarting the tunnel in 5 seconds..."
  sleep 5
end
